#!/usr/bin/python3
"""Bridge sudo's askpass protocol to the Quickshell password pill."""

import os
import json
import socket
import sys


def main() -> int:
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    socket_path = os.path.join(runtime_dir, "isla-sudo-askpass.sock")
    prompt = (sys.argv[1] if len(sys.argv) > 1 else os.environ.get("SUDO_PROMPT", "Password:"))
    prompt = prompt.replace("\n", " ").replace("\r", " ")

    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(120)
            try:
                client.connect(socket_path)
            except OSError:
                print("Isla: el formulario de contraseña no está disponible; comprueba Quickshell.",
                      file=sys.stderr)
                return 1
            request = {"prompt": prompt, "id": os.environ.get("ISLA_AUTH_ID", str(os.getppid())),
                       "tracked": bool(os.environ.get("ISLA_AUTH_ID"))}
            client.sendall((json.dumps(request) + "\n").encode())

            response = b""
            while b"\n" not in response:
                chunk = client.recv(4096)
                if not chunk:
                    return 1
                response += chunk

        value = response.split(b"\n", 1)[0]
        if value == b"__ISLA_CANCEL__":
            return 1
        sys.stdout.buffer.write(value + b"\n")
        sys.stdout.buffer.flush()
        return 0
    except (OSError, TimeoutError, KeyboardInterrupt):
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
