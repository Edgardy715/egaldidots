[general]
bars = 24
framerate = 60

[input]
method = pulse
source = alsa_output.usb-Corsair_Corsair_HS65_SURROUND-00.analog-stereo.monitor

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 255
bar_delimiter = 32
frame_delimiter = 10
channels = mono

[smoothing]
noise_reduction = 65

[color]
gradient = 0
