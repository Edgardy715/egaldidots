{
  "version": 1,
  "appearance": {
    "barLayout": "split",
    "glassAlpha": 0.34,
    "reduceTransparency": false,
    "materialDepth": 0.25,
    "liquidSurfaces": true,
    "stateIntensity": 1.0,
    "ambientFps": 60,
    "mediaTransitions": true,
    "personality": true,
    "menuSelectionAnchor": true,
    "pillBlur": false,
    "topGap": 1.0,
    "appGap": 1.0,
    "uiScale": 1.0,
    "fontScale": 1.0,
    "spacingScale": 1.0,
    "radiusScale": 1.0,
    "motionScale": 1.0,
    "fontFamily": "Google Sans Flex",
    "fontMonoFamily": "JetBrainsMono Nerd Font",
    "fontDisplayFamily": "Rubik",
    "reduceMotion": false,
    "time12h": true,
    "clockSeconds": false,
    "showGlyphs": true,
    "fontMediaFamily": "Inter"
  },
  "companion": {
    "sleepAfterSeconds": 180,
    "reactToCode": true,
    "reactToMusic": true,
    "reactAtNight": true,
    "followPointer": true,
    "mischief": "rare",
    "remember": true,
    "reactToSystem": true,
    "followFocus": true
  },
  "paths": {
    "wallpaperDir": "~/Wallpapers",
    "wallpaperCacheDir": "~/.cache/quickshell/wallpapers",
    "paletteFile": "~/.cache/matugen/palette.json",
    "wallpaperApplyScript": "~/.config/hypr/scripts/apply-wallpaper.sh",
    "userAvatar": "~/.face"
  },
  "profile": {
    "displayName": ""
  },
  "modules": {
    "workspaceRail": true,
    "systemStatus": true,
    "apps": true,
    "audio": true,
    "network": true,
    "battery": true,
    "animateChanges": true
  },
  "updates": {
    "enabled": true,
    "notifications": true
  }
}
